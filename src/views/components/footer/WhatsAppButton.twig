{#
  مكون زر الواتساب - WhatsApp Button Component
  ==========================================
  يظهر على اليمين (عائم)
  يظهر فقط عندما ينزل العميل تحت (scroll reveal)
  يظهر بعد اكتمال التحميل (loading-screen-assets)
  
  المتغيرات المتاحة:
  - component.WhatsAppButton: رقم الواتساب (required)
  - component.whatsapp_message: الرسالة الافتراضية (optional)
  - component.button_text: نص الزر (optional)
#}

{% if component.WhatsAppButton %}
  {% set phone = component.WhatsAppButton %}
  {% set message = component.whatsapp_message|default('مرحباً، أحتاج مساعدة')|url_encode %}
  {% set buttontext = component.button_text %}

  <a href="https://wa.me/{{ phone }}?text={{ message }}" 
     target="_blank" 
     rel="noopener noreferrer"
     class="whatsapp-button"
     id="whatsappButton"
     aria-label="تواصل معنا عبر واتساب">
    
    <svg class="whatsapp-icon" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
    </svg>

    {% if buttonText %}
      <span class="whatsapp-text">{{ buttonText }}</span>
    {% endif %}
    
  </a>
{% endif %}

<style>
/* WhatsApp Button Container - على اليمين، عائم، مخفي في البداية */
.whatsapp-button {
  margin-right: 35px;
  position: fixed;
  bottom: 25px;
  right: 25px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  background-color: #25D366;
  color: #ffffff;
  padding: 12px 20px;
  border-radius: 50px;
  text-decoration: none;
  font-size: 15px;
  font-weight: 600;
  box-shadow: 0 4px 15px rgba(37, 211, 102, 0.4);
  transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  z-index: 9998;
  border: none;
  cursor: pointer;
  outline: none;
  
  /* مخفي في البداية */
  opacity: 0;
  visibility: hidden;
  transform: translateY(30px);
}

/* حالة الظهور (بعد انتهاء الـ Loader وعند scroll) */
.whatsapp-button.whatsapp-visible {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
}

/* Hover State */
.whatsapp-button:hover {
  transform: translateY(-3px);
  box-shadow: 0 8px 25px rgba(37, 211, 102, 0.6);
  background-color: #22c55e;
}

/* Active State */
.whatsapp-button:active {
  transform: translateY(-1px);
  box-shadow: 0 4px 15px rgba(37, 211, 102, 0.4);
}

/* Focus State (Accessibility) */
.whatsapp-button:focus {
  outline: 2px solid rgba(37, 211, 102, 0.8);
  outline-offset: 2px;
}

/* WhatsApp Icon */
.whatsapp-icon {
  width: 24px;
  height: 24px;
  flex-shrink: 0;
  display: block;
}

/* WhatsApp Text */
.whatsapp-text {
  white-space: nowrap;
  display: block;
  font-weight: 500;
}

/* Tablet Screens */
@media (max-width: 768px) {
  .whatsapp-button {
    padding: 12px 16px;
    font-size: 14px;
    bottom: 20px;
    right: 15px;
  }

  .whatsapp-icon {
    width: 22px;
    height: 22px;
  }
}

/* Mobile Screens */
@media (max-width: 480px) {
  .whatsapp-button {
    padding: 0;
    border-radius: 50%;
    bottom: 15px;
    right: 15px;
    width: 56px;
    height: 56px;
    min-width: 56px;
    min-height: 56px;
  }

  .whatsapp-text {
    display: none;
  }

  .whatsapp-icon {
    width: 28px;
    height: 28px;
  }
}

/* Very Small Screens */
@media (max-width: 360px) {
  .whatsapp-button {
    bottom: 10px;
    right: 10px;
    padding: 0;
    width: 50px;
    height: 50px;
    min-width: 50px;
    min-height: 50px;
  }

  .whatsapp-icon {
    width: 24px;
    height: 24px;
  }
}

/* Print Styles */
@media print {
  .whatsapp-button {
    display: none !important;
  }
}

/* Dark Mode Support */
@media (prefers-color-scheme: dark) {
  .whatsapp-button {
    box-shadow: 0 4px 15px rgba(37, 211, 102, 0.3);
  }

  .whatsapp-button:hover {
    box-shadow: 0 8px 25px rgba(37, 211, 102, 0.5);
  }
}

/* Reduced Motion Preference */
@media (prefers-reduced-motion: reduce) {
  .whatsapp-button {
    transition: none;
  }

  .whatsapp-button.whatsapp-visible {
    opacity: 1;
    visibility: visible;
  }

  .whatsapp-button:hover {
    transform: none;
  }
}
</style>

<script>
(function() {
  'use strict';

  // الإعدادات
  const SCROLL_THRESHOLD = 300; // ظهر الزر بعد scroll 300px
  const SCROLL_CHECK_INTERVAL = 100; // فحص الـ scroll كل 100ms

  let loaderComplete = false;
  let isScrolledEnough = false;

  // انتظر حتى يكون الـ DOM جاهز
  function initWhatsAppButton() {
    const whatsappButton = document.getElementById('whatsappButton');
    if (!whatsappButton) return;

    // البحث عن الـ Loader
    const loader = document.querySelector('.loader-init');

    if (loader) {
      // إذا كان الـ Loader موجود، انتظر حتى يختفي
      const checkLoaderHidden = () => {
        if (loader.classList.contains('loader-init--hidden')) {
          loaderComplete = true;
          updateButtonVisibility();
        } else {
          setTimeout(checkLoaderHidden, 100);
        }
      };

      checkLoaderHidden();

      // أيضاً استمع لـ transitionend event
      loader.addEventListener('transitionend', () => {
        loaderComplete = true;
        updateButtonVisibility();
      }, { once: true });
    } else {
      // لا توجد شاشة تحميل - الـ Loader جاهز مباشرة
      loaderComplete = true;
      updateButtonVisibility();
    }

    // بديل: إذا لم يكن الـ Loader قد اختفى بعد 5 ثواني، اعتبره جاهز
    setTimeout(() => {
      if (!loaderComplete) {
        console.warn('⚠️ WhatsApp Button: تم تجاوز انتظار الـ Loader بعد 5 ثواني');
        loaderComplete = true;
        updateButtonVisibility();
      }
    }, 5000);

    // مراقبة الـ scroll
    startScrollListener();

    // اضغط على الزر - تأثير موجة
    attachRippleEffect(whatsappButton);
  }

  function startScrollListener() {
    // استخدم throttle لتقليل عدد المرات التي يتم حساب الـ scroll فيها
    let scrollCheckTimeout;
    
    function checkScroll() {
      const scrollTop = window.scrollY || document.documentElement.scrollTop;
      const newScrolledEnough = scrollTop > SCROLL_THRESHOLD;
      
      if (newScrolledEnough !== isScrolledEnough) {
        isScrolledEnough = newScrolledEnough;
        updateButtonVisibility();
      }
      
      scrollCheckTimeout = setTimeout(checkScroll, SCROLL_CHECK_INTERVAL);
    }

    window.addEventListener('scroll', checkScroll, { passive: true });
    
    // ابدأ الفحص
    checkScroll();
  }

  function updateButtonVisibility() {
    const whatsappButton = document.getElementById('whatsappButton');
    if (!whatsappButton) return;

    // الزر يظهر إذا:
    // 1. انتهى الـ Loader (loaderComplete = true)
    // 2. و المستخدم نزل تحت (isScrolledEnough = true)
    if (loaderComplete && isScrolledEnough) {
      if (!whatsappButton.classList.contains('whatsapp-visible')) {
        whatsappButton.classList.add('whatsapp-visible');
        console.log('✅ WhatsApp Button: تم إظهار الزر بنجاح');
      }
    } else {
      // إخفاء الزر إذا نقص الشرط
      if (whatsappButton.classList.contains('whatsapp-visible') && !isScrolledEnough) {
        whatsappButton.classList.remove('whatsapp-visible');
        console.log('👁️ WhatsApp Button: تم إخفاء الزر');
      }
    }
  }

  function attachRippleEffect(whatsappButton) {
    whatsappButton.addEventListener('click', function(e) {
      const rect = this.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;

      const ripple = document.createElement('span');
      ripple.style.position = 'absolute';
      ripple.style.width = '20px';
      ripple.style.height = '20px';
      ripple.style.left = x - 10 + 'px';
      ripple.style.top = y - 10 + 'px';
      ripple.style.backgroundColor = 'rgba(255, 255, 255, 0.5)';
      ripple.style.borderRadius = '50%';
      ripple.style.animation = 'ripple 0.6s ease-out';
      ripple.style.pointerEvents = 'none';

      this.appendChild(ripple);

      setTimeout(() => ripple.remove(), 600);
    });
  }

  // بدء التهيئة عند تحميل الـ DOM
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initWhatsAppButton);
  } else {
    initWhatsAppButton();
  }

  // إضافة animation للـ ripple effect إذا لم تكن موجودة
  if (!document.querySelector('style[data-whatsapp-ripple]')) {
    const style = document.createElement('style');
    style.setAttribute('data-whatsapp-ripple', 'true');
    style.textContent = `
      @keyframes ripple {
        to {
          transform: scale(4);
          opacity: 0;
        }
      }
      
      .whatsapp-button {
        position: relative;
        overflow: hidden;
      }
    `;
    document.head.appendChild(style);
  }
})();
</script>
