{% set video_extensions = ['.mp4', '.webm', '.ogg', '.mov'] %}
{% set banner_url_lower = (component.banner_url | default('')) | lower %}
{% set is_video_url = false %}
{% for ext in video_extensions %}
    {% if banner_url_lower ends with ext %}
        {% set is_video_url = true %}
    {% endif %}
{% endfor %}
{% set actual_video = component.banner_video | default(is_video_url ? component.banner_url : '') %}
{% set actual_image = component.banner_image | default('') %}
{% set banner_title = component.banner_title | default('عرض مميز') %}
{% set banner_subtitle = component.banner_subtitle | default('اكتشفي أحدث المنتجات بأسعار خاصة') %}
{% set button_text = component.button_text | default('اكتشفي المزيد') %}
{% set button_url = component.banner_url | default('#') %}
{% set title_color = component.title_color | default('#004956') %}
{% set subtitle_color = component.subtitle_color | default('#004956') %}
{% set button_bg = component.button_color | default('#004956') %}
{% set button_text_color = component.buttontext_color | default('#004956') %}
<section class="animated-banner-wrapper">
    <div class="animated-banner">
        <div class="animated-banner-container">
            {# الفيديو #}
            {% if actual_video and actual_video != '' %}
                <video class="animated-banner-video" autoplay muted loop playsinline preload="auto" webkit-playsinline>
                    <source src="{{ actual_video }}" type="video/mp4"></video>
                {# الصورة #}
                    {% elseif actual_image and actual_image != '' %}
                    <img
                src="{{ actual_image }}" alt="{{ banner_title }}" class="animated-banner-img" loading="lazy" />
                    {% else %}
                    {# لون افتراضي إذا ما فيه صورة أو فيديو #}
                    <div class="animated-banner-default-bg"></div>
                {% endif %}
                {# طبقة التعتيم #}
                <div class="animated-banner-overlay"></div>
                {# محتوى البنر #}
                <div class="animated-banner-content">
                    {# العنوان الرئيسي #}
                    {% if banner_title %}
                        <h2 class="animated-banner-title" style="color: {{ title_color }};">
                            {{ banner_title }}
                        </h2>
                    {% endif %}
                    {# الوصف الفرعي #}
                    {% if banner_subtitle %}
                        <p class="animated-banner-description" style="color: {{ subtitle_color }};">
                            {{ banner_subtitle }}
                        </p>
                    {% endif %}
                    {# زر CTA #}
                    {% if button_text %}
                        <a href="{{ button_url }}" class="animated-cta-button" style="background-color: {{ button_bg }}; color: {{ button_text_color }};">
                            <span class="button-text">
                                {{ button_text }}
                            </span>
                            <svg class="animated-button-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none">
                                <path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        </a>
                    {% endif %}
                </div>
            </div>
        </div>
    </section>
    <style>
/* ============================================
   ANIMATED BANNER STYLES
   ============================================ */

.animated-banner-wrapper {
    margin: 0;
    padding: 0;
    width: 100%;
}

.animated-banner {
    width: 100%;
    height: 600px;
    position: relative;
    overflow: hidden;
}

.animated-banner-container {
    width: 100%;
    height: 100%;
    position: relative;
}

/* الفيديو والصورة */
.animated-banner-video,
.animated-banner-img,
.animated-banner-default-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}

.animated-banner-default-bg {
    background: linear-gradient(135deg, #ff69b4 0%, #004956 100%);
}

/* طبقة التعتيم */
.animated-banner-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.4);
    z-index: 1;
}

/* محتوى البنر */
.animated-banner-content {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 2;
    text-align: center;
    width: 90%;
    max-width: 900px;
    display: flex;
    flex-direction: column;
    align-items: center;
    animation: fadeInUp 0.8s ease-out forwards;
}

@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translate(-50%, -40%);
    }
    to {
        opacity: 1;
        transform: translate(-50%, -50%);
    }
}

/* العنوان الرئيسي */
.animated-banner-title {
    font-size: clamp(2rem, 3vw, 3.5rem);
    font-weight: 700;
    margin: 0 0 20px 0;
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.5);
    line-height: 1.2;
    animation: slideInDown 0.8s ease-out 0.2s forwards;
    opacity: 0;
}

@keyframes slideInDown {
    from {
        opacity: 0;
        transform: translateY(-30px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* الوصف الفرعي */
.animated-banner-description {
    font-size: clamp(1rem, 2.5vw, 1.3rem);
    font-weight: 400;
    margin: 0 0 30px 0;
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.4);
    line-height: 1.4;
    max-width: 600px;
    animation: slideInUp 0.8s ease-out 0.4s forwards;
    opacity: 0;
}

@keyframes slideInUp {
    from {
        opacity: 0;
        transform: translateY(30px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* زر CTA */
.animated-cta-button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 32px;
    border-radius: 50px;
    font-weight: 600;
    font-size: 16px;
    position: relative;
    overflow: hidden;
    transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    text-decoration: none;
    cursor: pointer;
    z-index: 5;
    border: none;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
    animation: scaleIn 0.8s ease-out 0.6s forwards;
    opacity: 0;
    transform-origin: center;
}

@keyframes scaleIn {
    from {
        opacity: 0;
        transform: scale(0.8);
    }
    to {
        opacity: 1;
        transform: scale(1);
    }
}

.animated-cta-button::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
    transition: left 0.5s ease;
    z-index: 0;
}

.animated-cta-button:hover::before {
    left: 100%;
}

.animated-cta-button:hover {
    transform: translateY(-3px);
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.3);
}

.button-text,
.animated-button-arrow {
    position: relative;
    z-index: 2;
}

.animated-button-arrow {
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.animated-cta-button:hover .animated-button-arrow {
    transform: translateX(4px);
}

/* ============================================
   RESPONSIVE DESIGN
   ============================================ */

@media (max-width: 1024px) {
    .animated-banner {
        height: 500px;
    }

    .animated-banner-title {
        font-size: clamp(1.8rem, 4vw, 2.8rem);
    }

    .animated-banner-description {
        font-size: clamp(0.95rem, 2vw, 1.1rem);
    }
}

@media (max-width: 768px) {
    .animated-banner {
        height: 400px;
    }

    .animated-banner-content {
        width: 95%;
    }

    .animated-banner-title {
        font-size: 1.8rem;
        margin-bottom: 15px;
    }

    .animated-banner-description {
        font-size: 1rem;
        margin-bottom: 20px;
    }

    .animated-cta-button {
        padding: 12px 26px;
        font-size: 15px;
    }

    .animated-banner-overlay {
        background: rgba(0, 0, 0, 0.5);
    }
}

@media (max-width: 480px) {
    .animated-banner {
        height: 300px;
    }

    .animated-banner-content {
        width: 95%;
    }

    .animated-banner-title {
        font-size: 1.4rem;
        margin-bottom: 12px;
    }

    .animated-banner-description {
        font-size: 0.9rem;
        margin-bottom: 15px;
    }

    .animated-cta-button {
        padding: 10px 22px;
        font-size: 14px;
        gap: 6px;
    }

    .animated-button-arrow {
        width: 18px;
        height: 18px;
    }
}

/* Dark Mode */
body.dark-mode .animated-banner-overlay {
    background: rgba(0, 0, 0, 0.6);
}
</style>
    <script>
document.addEventListener('DOMContentLoaded', function() {
    const banner = document.querySelector('.animated-banner-content');
    
    if (!banner) return;

    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.style.animation = 'fadeInUp 0.8s ease-out forwards';
            }
        });
    }, {
        threshold: 0.5
    });

    observer.observe(banner);

    // Pause video on mobile for performance
    const video = document.querySelector('.animated-banner-video');
    if (video && window.innerWidth < 768) {
        video.autoplay = false;
        video.controls = true;
    }
});
</script>
    